{
  "name": "Agency Lead Intake, Qualification and Onboarding",
  "nodes": [
    {
      "id": "n1", "name": "New Lead Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [200, 300],
      "webhookId": "agency-lead-intake",
      "parameters": { "httpMethod": "POST", "path": "agency-lead", "responseMode": "onReceived" }
    },
    {
      "id": "n2", "name": "Normalize Lead", "type": "n8n-nodes-base.set", "typeVersion": 1, "position": [420, 300],
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            { "name": "name", "value": "={{$json.body.name}}" },
            { "name": "email", "value": "={{$json.body.email}}" },
            { "name": "company", "value": "={{$json.body.company}}" },
            { "name": "service", "value": "={{$json.body.service}}" },
            { "name": "message", "value": "={{$json.body.message}}" },
            { "name": "source", "value": "={{$json.body.source || 'website'}}" }
          ],
          "number": [
            { "name": "budget", "value": "={{Number($json.body.budget) || 0}}" }
          ]
        }
      }
    },
    {
      "id": "n3", "name": "Budget >= 3000?", "type": "n8n-nodes-base.if", "typeVersion": 1, "position": [640, 300],
      "parameters": {
        "conditions": { "number": [ { "value1": "={{$json.budget}}", "operation": "largerEqual", "value2": 3000 } ] }
      }
    },
    {
      "id": "n4", "name": "Log Qualified Lead", "type": "n8n-nodes-base.googleSheets", "typeVersion": 2, "position": [880, 200],
      "parameters": {
        "operation": "append",
        "documentId": "YOUR_SHEET_ID",
        "sheetName": "Qualified Leads",
        "columns": { "mappingMode": "autoMapInputData", "value": {} }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "Google Sheets" } }
    },
    {
      "id": "n5", "name": "Alert Sales in Slack", "type": "n8n-nodes-base.slack", "typeVersion": 1, "position": [1100, 200],
      "parameters": {
        "channel": "#new-leads",
        "text": "=:fire: Qualified lead: {{$json.name}} ({{$json.company}})\nService: {{$json.service}} | Budget: ${{$json.budget}}\nEmail: {{$json.email}}\nMessage: {{$json.message}}"
      },
      "credentials": { "slackApi": { "id": "", "name": "Slack" } }
    },
    {
      "id": "n6", "name": "Send Booking Email", "type": "n8n-nodes-base.gmail", "typeVersion": 1, "position": [1320, 200],
      "parameters": {
        "resource": "message", "operation": "send",
        "sendTo": "={{$('Normalize Lead').item.json.email}}",
        "subject": "=Thanks {{$('Normalize Lead').item.json.name}}, let's talk about {{$('Normalize Lead').item.json.service}}",
        "message": "=Hi {{$('Normalize Lead').item.json.name}},\n\nThanks for reaching out. Book a strategy call here: https://YOUR-CALENDAR-LINK\n\nTalk soon,\nThe Team"
      },
      "credentials": { "gmailOAuth2": { "id": "", "name": "Gmail" } }
    },
    {
      "id": "n7", "name": "Log Nurture Lead", "type": "n8n-nodes-base.googleSheets", "typeVersion": 2, "position": [880, 420],
      "parameters": {
        "operation": "append",
        "documentId": "YOUR_SHEET_ID",
        "sheetName": "Nurture Leads",
        "columns": { "mappingMode": "autoMapInputData", "value": {} }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "Google Sheets" } }
    },
    {
      "id": "n8", "name": "Send Nurture Email", "type": "n8n-nodes-base.gmail", "typeVersion": 1, "position": [1100, 420],
      "parameters": {
        "resource": "message", "operation": "send",
        "sendTo": "={{$json.email}}",
        "subject": "Thanks for reaching out",
        "message": "=Hi {{$json.name}},\n\nThanks for your interest. Here is our free guide and pricing overview: https://YOUR-RESOURCE-LINK\n\nReply any time with questions.\n\nThe Team"
      },
      "credentials": { "gmailOAuth2": { "id": "", "name": "Gmail" } }
    }
  ],
  "connections": {
    "New Lead Webhook": { "main": [[{ "node": "Normalize Lead", "type": "main", "index": 0 }]] },
    "Normalize Lead": { "main": [[{ "node": "Budget >= 3000?", "type": "main", "index": 0 }]] },
    "Budget >= 3000?": { "main": [
      [{ "node": "Log Qualified Lead", "type": "main", "index": 0 }],
      [{ "node": "Log Nurture Lead", "type": "main", "index": 0 }]
    ] },
    "Log Qualified Lead": { "main": [[{ "node": "Alert Sales in Slack", "type": "main", "index": 0 }]] },
    "Alert Sales in Slack": { "main": [[{ "node": "Send Booking Email", "type": "main", "index": 0 }]] },
    "Log Nurture Lead": { "main": [[{ "node": "Send Nurture Email", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {}
}
