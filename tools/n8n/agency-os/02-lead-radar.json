      "id": "e3b3fa00-acdc-4c7c-8a6c-9d3c183bc6a2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst pick = (...keys) => {\n  for (const k of Object.keys(src)) {\n    const norm = k.toLowerCase().replace(/[^a-z]/g, '');\n    if (keys.some((want) => norm.startsWith(want))) { const v = src[k]; if (v !== undefined && v !== '') return String(v).trim(); }\n  }\n  return '';\n};\nconst email = pick('email').toLowerCase();\nconst free = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'icloud.com', 'aol.com', 'proton.me', 'protonmail.com', 'live.com'];\nlet website = pick('website', 'url', 'site', 'domain');\nconst domain = email.split('@')[1] || '';\nif (!website && domain && !free.includes(domain)) website = domain;\nif (website && !/^https?:\\/\\//i.test(website)) website = 'https://' + website;\nreturn { json: {\n  created_at: new Date().toISOString(),\n  name: pick('name', 'fullname', 'firstname'), email, company: pick('company', 'business', 'organization'),\n  website, service: pick('service', 'interest', 'need') || 'Not sure yet',\n  budget: Number(pick('monthlybudget', 'budget').replace(/[^0-9.]/g, '')) || 0,\n  message: pick('message', 'whatdoyou', 'goal', 'details', 'notes'),\n  source: pick('source', 'utmsource') || ($json.formMode ? 'n8n form' : 'website'),\n} };\n"
      },
      "id": "3ec97a20-8121-403a-a639-b9b1737d6941",
      "name": "Normalize Lead",
