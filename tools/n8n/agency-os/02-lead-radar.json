      "id": "4280adb4-8746-4211-89b9-abed38232214",
      "name": "Fetch Lead Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        400
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const stripHtml = (h) => String(h || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<noscript[\\s\\S]*?<\\/noscript>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#39;|&apos;/g, \"'\").replace(/&quot;/g, '\"')\n  .replace(/\\s+/g, ' ').trim();\nconst grab = (h, re) => { const m = String(h || '').match(re); return m ? stripHtml(m[1]).slice(0, 300) : ''; };\nconst grabAll = (h, re, n = 10) => [...String(h || '').matchAll(re)].map((m) => stripHtml(m[1])).filter(Boolean).slice(0, n);\n\nconst lead = $('Normalize Lead').item.json;\nconst html = typeof $json.html === 'string' ? $json.html : '';\nconst has = (re) => re.test(html);\nconst stack = Object.entries({\n  'Google Analytics 4': /gtag\\(|googletagmanager\\.com\\/gtag|G-[A-Z0-9]{6,}/, 'Google Tag Manager': /GTM-[A-Z0-9]+/,\n  'Meta Pixel': /connect\\.facebook\\.net|fbq\\(/, 'LinkedIn Insight': /snap\\.licdn\\.com/, 'TikTok Pixel': /analytics\\.tiktok\\.com/,\n  'HubSpot': /js\\.hs-scripts\\.com|hubspot/i, 'Shopify': /cdn\\.shopify\\.com|Shopify\\.theme/, 'WordPress': /wp-content|wp-includes/,\n  'Webflow': /webflow/i, 'Wix': /wixstatic|wix\\.com/, 'Squarespace': /squarespace/i, 'Intercom': /intercom/i,\n  'Calendly': /calendly/i, 'Stripe': /js\\.stripe\\.com/, 'Klaviyo': /klaviyo/i,\n}).filter(([, re]) => has(re)).map(([k]) => k);\nconst site = html ? {\n  reachable: true, title: grab(html, /<title[^>]*>([\\s\\S]*?)<\\/title>/i),\n  meta_description: (html.match(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']*)/i) || [])[1] || '',\n  h1: grabAll(html, /<h1[^>]*>([\\s\\S]*?)<\\/h1>/gi, 3), tech_stack: stack,\n  text_excerpt: stripHtml(html).slice(0, 2500),\n} : { reachable: false };\n\nconst schema = {\n  type: 'object', additionalProperties: false,\n  required: ['score', 'tier', 'fit_summary', 'recommended_service', 'est_deal_value_usd', 'buying_signals', 'risks', 'personalized_opener', 'next_best_action'],\n  properties: {\n    score: { type: 'integer', description: 'Fit and intent score from 0 to 100' },\n    tier: { type: 'string', enum: ['hot', 'warm', 'cold', 'spam'] },\n    fit_summary: { type: 'string', description: 'Two sentences on why this lead does or does not fit' },\n    recommended_service: { type: 'string' },\n    est_deal_value_usd: { type: 'integer', description: 'Estimated monthly retainer value' },\n    buying_signals: { type: 'array', items: { type: 'string' } },\n    risks: { type: 'array', items: { type: 'string' } },\n    personalized_opener: { type: 'string', description: 'One sentence referencing something specific about their business, for the first email' },\n    next_best_action: { type: 'string' },\n  },\n};\nconst cfg = $('Config').first().json;\nreturn { json: { ...lead, site, brain: {\n  skill: 'revops', caller: 'Lead Radar', client: lead.company, effort: 'medium', max_tokens: 4000, schema,\n  context: { agency: cfg.agency_name, lead, website_signals: site },\n  task: `Score this inbound lead for ${cfg.agency_name}. Use the lead-scoring approach from your playbook: fit (company, website maturity, budget vs the requested service) plus intent (message specificity, urgency). A monthly budget under $1,000 for paid media or full-funnel work is weak fit. Use \"spam\" for junk or vendor pitches. \"hot\" needs score >= ${cfg.min_hot_score}. The opener must reference something real from their website or message.`,\n} } };\n"
      },
      "id": "c863a2a4-4fbe-44c1-8e51-aa4a120471dc",
