      "id": "7bd5b916-e345-4386-9772-8d2e1de05f66",
      "name": "Brain: Score Lead",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1200,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a = $json.ai || {};\nif (a.score !== undefined) a.score = Math.max(0, Math.min(100, Math.round(Number(a.score) || 0)));\nconst hot = Number($('Config').first().json.min_hot_score);\nlet tier = a.tier || 'warm';\nif (tier === 'hot' && (a.score || 0) < hot) tier = 'warm';\nreturn { json: {\n  created_at: $json.created_at, name: $json.name, email: $json.email, company: $json.company, website: $json.website,\n  service: $json.service, budget: $json.budget, message: $json.message, source: $json.source,\n  score: a.score ?? '', tier: $json.ai_error ? 'needs review' : tier, recommended_service: a.recommended_service || '',\n  est_deal_value_usd: a.est_deal_value_usd ?? '', fit_summary: a.fit_summary || $json.ai_error || '',\n  buying_signals: (a.buying_signals || []).join('; '), risks: (a.risks || []).join('; '),\n  next_best_action: a.next_best_action || '', personalized_opener: a.personalized_opener || '',\n} };\n"
      },
