              "outputPropertyName": "html"
            }
          },
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "allowUnauthorizedCerts": false
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
