    {
      "parameters": {
        "jsCode": "const rowsOf = (node) => { try { return $(node).all().map((i) => i.json).filter((r) => r && Object.keys(r).length); } catch (e) { return []; } };\nconst activeClients = () => rowsOf('Read Clients').filter((c) => c.client_id && String(c.status || '').toLowerCase() === 'active');\nconst ymd = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\nconst daysAgo = (s) => { const t = Date.parse(s); return Number.isNaN(t) ? null : Math.floor((Date.now() - t) / 864e5); };\n\nconst clients = Object.fromEntries(activeClients().map((c) => [c.client_id, c]));\nreturn rowsOf('Read Competitors').filter((r) => r.competitor_url && clients[r.client_id])\n  .map((r) => ({ json: { ...r, client_name: clients[r.client_id].client_name, client_positioning: clients[r.client_id].goals || '', client_website: clients[r.client_id].website } }));\n"
      },
      "id": "7412fba2-f5d1-4062-b7e5-b6842062ab87",
      "name": "Valid Competitors",
