      "typeVersion": 2,
      "position": [
        960,
        400
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.competitor_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          },
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "allowUnauthorizedCerts": false
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; AgencyOS-Audit/1.0)"
            }
          ]
        }
      },
      "id": "3a9b9d7c-1f5f-435d-8ff8-833dd9c25116",
      "name": "Fetch Competitor Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        400
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const stripHtml = (h) => String(h || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<noscript[\\s\\S]*?<\\/noscript>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#39;|&apos;/g, \"'\").replace(/&quot;/g, '\"')\n  .replace(/\\s+/g, ' ').trim();\nconst grab = (h, re) => { const m = String(h || '').match(re); return m ? stripHtml(m[1]).slice(0, 300) : ''; };\nconst grabAll = (h, re, n = 10) => [...String(h || '').matchAll(re)].map((m) => stripHtml(m[1])).filter(Boolean).slice(0, n);\n\nconst c = $('Valid Competitors').item.json;\nconst cfg = $('Config').first().json;\nconst html = typeof $json.html === 'string' ? $json.html : '';\nconst snapshot = stripHtml(html).slice(0, 8000);\nconst prev = String(c.last_snapshot || '');\nconst sents = (s) => new Set(s.split(/(?<=[.!?])\\s+/).map((t) => t.trim()).filter((t) => t.length > 25));\nconst A = sents(snapshot), B = sents(prev);\nconst added = [...A].filter((t) => !B.has(t)).slice(0, 25);\nconst removed = [...B].filter((t) => !A.has(t)).slice(0, 25);\nconst prices = (s) => [...new Set((s.match(/[$\u20ac\u00a3]\\s?\\d[\\d,.]*(?:\\s?\\/\\s?(?:mo|month|yr|year|user|seat))?/gi) || []))];\nconst changed = !!prev && !!snapshot && (added.length + removed.length) >= Number(cfg.min_changed_sentences);\nconst schema = { type: 'object', additionalProperties: false, required: ['change_type', 'significance', 'what_changed', 'what_it_signals', 'counter_moves'],\n  properties: { change_type: { type: 'string', enum: ['pricing', 'positioning', 'product', 'offer', 'social_proof', 'content', 'minor'] },\n    significance: { type: 'string', enum: ['low', 'medium', 'high'] }, what_changed: { type: 'string' }, what_it_signals: { type: 'string' },\n    counter_moves: { type: 'array', items: { type: 'string' } } } };\nreturn { json: { client_id: c.client_id, client_name: c.client_name, competitor_url: c.competitor_url, reachable: !!snapshot, changed, snapshot,\n  brain: { skill: 'competitor-profiling', caller: 'Competitor Radar', client: c.client_name, effort: 'medium', max_tokens: 4000, schema,\n    context: { our_client: c.client_name, our_client_site: c.client_website, our_client_goals: c.client_positioning, competitor: c.competitor_url,\n      sentences_added: added, sentences_removed: removed, prices_before: prices(prev), prices_now: prices(snapshot) },\n    task: 'A competitor page changed since last week. Classify the change, rate its significance for our client (rotating testimonials, dates and cookie banners are \"minor\"/\"low\"), explain what it signals about the competitor\\'s strategy, and give 2-3 specific counter-moves for our client.' } } };\n"
      },
