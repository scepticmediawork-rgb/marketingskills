    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Thanks!</title></head><body style=\"font-family:-apple-system,Segoe UI,Roboto,sans-serif;background:#f9fafb;margin:0\"><div style=\"max-width:520px;margin:12vh auto;background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:32px 28px;text-align:center\"><div style=\"font-size:44px\">{{ $('Verify Token').item.json.status === 'Approved' ? '\u2705' : '\u270f\ufe0f' }}</div><h1 style=\"font-size:22px;margin:12px 0 8px;color:#111827\">{{ $('Verify Token').item.json.status === 'Approved' ? 'Approved. We will publish it on schedule.' : 'Got it. We will revise this post.' }}</h1><p style=\"color:#4b5563;margin:0\">&ldquo;{{ $('Verify Token').item.json.hook }}&rdquo;</p></div></body></html>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
