    {
      "parameters": {
        "jsCode": "const rowsOf = (node) => { try { return $(node).all().map((i) => i.json).filter((r) => r && Object.keys(r).length); } catch (e) { return []; } };\nconst activeClients = () => rowsOf('Read Clients').filter((c) => c.client_id && String(c.status || '').toLowerCase() === 'active');\nconst ymd = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\nconst daysAgo = (s) => { const t = Date.parse(s); return Number.isNaN(t) ? null : Math.floor((Date.now() - t) / 864e5); };\n\nconst cfg = $('Config').first().json;\nconst keys = Object.fromEntries(rowsOf('Read Clients').map((c) => [c.client_id, c.ayrshare_profile_key || '']));\nconst horizon = Date.now() + Number(cfg.schedule_window_hours || 36) * 36e5;\nconst platform = { linkedin: 'linkedin', instagram: 'instagram', x: 'twitter', twitter: 'twitter', facebook: 'facebook', tiktok: 'tiktok' };\nconst needsMedia = ['instagram', 'tiktok'];\nreturn rowsOf('Read Content')\n  .filter((r) => r.status === 'Approved' && Date.parse(r.publish_at) <= horizon)\n  .map((r) => {\n    const text = [r.hook, r.body, r.cta, r.hashtags].filter(Boolean).join('\\n\\n');\n    const when = Date.parse(r.publish_at);\n    const payload = { post: text, platforms: [platform[r.channel] || r.channel] };\n    if (when > Date.now() + 5 * 60e3) payload.scheduleDate = new Date(when).toISOString();\n    if (r.media_url) payload.mediaUrls = [r.media_url];\n    return { json: { id: r.id, client_name: r.client_name, channel: r.channel, hook: r.hook,\n      needs_visual: needsMedia.includes(r.channel) && !r.media_url, payload,\n      headers: keys[r.client_id] ? { 'Profile-Key': keys[r.client_id] } : {} } };\n  });\n"
      },
