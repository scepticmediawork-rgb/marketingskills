    {
      "parameters": {
        "jsCode": "const q = $('Review Link Clicked').first().json.query || {};\nconst row = $input.all().map((i) => i.json).find((r) => r.id === q.id);\nconst decision = q.d === 'approve' ? 'Approved' : q.d === 'changes' ? 'Changes requested' : null;\nconst valid = !!(row && row.token && row.token === q.t && decision);\nconst locked = row && ['Scheduled', 'Published'].includes(row.status);\nreturn [{ json: { valid: valid && !locked, locked: !!locked, id: q.id, status: decision, reviewed_at: new Date().toISOString(),\n  client_name: row?.client_name || '', hook: row?.hook || '', channel: row?.channel || '' } }];\n"
      },
