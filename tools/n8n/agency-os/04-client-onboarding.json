    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const services = [].concat($json['Services'] || []).join(', ');\nconst name = String($json['Client name']).trim();\nconst slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);\nlet website = String($json['Website'] || '').trim();\nif (website && !/^https?:\\/\\//i.test(website)) website = 'https://' + website;\nreturn { json: {\n  client_id: `${slug}-${Date.now().toString(36).slice(-4)}`, client_name: name, status: 'active', website,\n  contact_name: $json['Primary contact name'], contact_email: $json['Primary contact email'],\n  account_manager_email: $json['Account manager email'], services, retainer_usd: Number($json['Monthly retainer (USD)']) || 0,\n  start_date: new Date().toISOString().slice(0, 10), ga4_property_id: String($json['GA4 property ID'] || '').replace(/\\D/g, ''),\n  brand_voice: $json['Brand voice'] || '', audience: $json['Target audience'] || '', goals: $json['Goals for the first 90 days'] || '',\n  competitors: $json['Competitor URLs (comma separated)'] || '', channel_name: `client-${slug}`.slice(0, 80),\n} };\n"
      },
      "id": "737403de-5ae8-4273-bdfd-2befcf25fd71",
      "name": "Normalize Client",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
