    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst li = (arr) => (arr || []).map((t) => `<li style=\"margin:0 0 6px\">${esc(t)}</li>`).join('');\nconst card = (title, inner) => `<div style=\"border:1px solid #e5e7eb;border-radius:10px;padding:18px 20px;margin:0 0 16px\"><h3 style=\"margin:0 0 10px;font-size:16px;color:#111827\">${esc(title)}</h3>${inner}</div>`;\nconst shell = (title, sub, inner) => `<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;max-width:680px;margin:0 auto;color:#1f2937;line-height:1.5\"><div style=\"padding:24px 0 8px\"><div style=\"font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#6b7280\">${esc(sub)}</div><h1 style=\"margin:4px 0 0;font-size:24px;color:#111827\">${esc(title)}</h1></div>${inner}</div>`;\nconst pct = (v) => (v === null || v === undefined || Number.isNaN(v)) ? 'n/a' : `${v > 0 ? '+' : ''}${v.toFixed(1)}%`;\n\nconst x = $('Brain: 90-Day Plan').item.json; const p = x.ai || {};\nconst cfg = $('Config').first().json;\nconst first = String(x.contact_name || '').split(' ')[0] || 'there';\nconst goals = (p.goals || []).map((g) => `<li style=\"margin:0 0 6px\"><b>${esc(g.goal)}</b>: ${esc(g.metric)} \u2192 ${esc(g.target)}</li>`).join('');\nconst phases = (p.phases || []).map((ph) => `<li style=\"margin:0 0 8px\"><b>${esc(ph.name)} (${esc(ph.weeks)})</b>: ${esc(ph.focus)}<ul style=\"padding-left:18px\">${li(ph.initiatives)}</ul></li>`).join('');\nconst html = shell(`Welcome aboard, ${x.client_name}!`, `${cfg.agency_name} \u00b7 your first 90 days`,\n  `<p>Hi ${esc(first)},</p><p>We're excited to get started. Here's the plan we'll walk through at kickoff. It's a draft, and we'll shape it together.</p>`\n  + card('North-star metric', `<p style=\"margin:0;font-size:18px;font-weight:700\">${esc(p.north_star_metric)}</p>`)\n  + card('Goals', `<ul style=\"padding-left:18px;margin:0\">${goals}</ul>`)\n  + card('The plan', `<ul style=\"padding-left:18px;margin:0\">${phases}</ul>`)\n  + card('Quick wins in the first 2 weeks', `<ul style=\"padding-left:18px;margin:0\">${li(p.quick_wins_first_2_weeks)}</ul>`)\n  + card('What we need from you', `<ul style=\"padding-left:18px;margin:0\">${li(p.access_needed)}</ul><p style=\"margin:10px 0 0\">Access checklist: <a href=\"${esc(cfg.onboarding_form_link)}\">${esc(cfg.onboarding_form_link)}</a></p>`)\n  + `<p style=\"margin:20px 0\"><a href=\"${esc(cfg.kickoff_booking_link)}\" style=\"background:#4f46e5;color:#fff;padding:12px 20px;border-radius:8px;text-decoration:none;font-weight:600\">Book your kickoff call</a></p>`\n  + `<p>Talk soon,<br>The ${esc(cfg.agency_name)} team</p>`);\nconst slack_text = `:tada: *${x.client_name} is live!* Retainer $${x.retainer_usd}/mo \u00b7 ${x.services}\\n*North star:* ${p.north_star_metric || 'n/a'}\\n*Quick wins:*\\n${(p.quick_wins_first_2_weeks || []).map((w) => `\u2022 ${w}`).join('\\n')}\\n*Risks:*\\n${(p.risks || []).map((w) => `\u2022 ${w}`).join('\\n')}\\n*Kickoff agenda:*\\n${(p.kickoff_agenda || []).map((w, i) => `${i + 1}. ${w}`).join('\\n')}`;\nreturn { json: { ...x, subject: `Welcome to ${cfg.agency_name}: your 90-day plan`, html, slack_text } };\n"
      },
