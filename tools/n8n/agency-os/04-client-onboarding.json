                  },
                  {
                    "option": "Email"
                  },
                  {
                    "option": "CRO / Website"
                  },
                  {
                    "option": "Reporting"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Monthly retainer (USD)",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Goals for the first 90 days",
              "fieldType": "textarea",
              "requiredField": true
