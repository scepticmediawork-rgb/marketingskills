              "fieldType": "textarea"
            },
            {
              "fieldLabel": "GA4 property ID"
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Onboarding started: folder, channel, strategy doc and 90-day plan are on the way."
            }
          }
        }
      },
