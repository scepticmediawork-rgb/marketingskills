    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $('Brain: 90-Day Plan').all()) {\n  const c = item.json;\n  for (const url of String(c.competitors || '').split(/[\\s,]+/).filter((u) => /\\./.test(u))) {\n    out.push({ json: { client_id: c.client_id, competitor_url: /^https?:/.test(url) ? url : `https://${url}`, last_checked: '', last_snapshot: '', last_change_summary: '' } });\n  }\n}\nreturn out;\n"
      },
