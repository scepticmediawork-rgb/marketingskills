    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $('Normalize Client').item.json;\nconst folder = $('Create Drive Folder').item.json;\nconst channel = $json;\nreturn { json: { ...c, drive_folder_id: folder.id || '', slack_channel_id: channel.id || '', brain: {\n  skill: 'product-marketing', caller: 'Onboarding', client: c.client_name, effort: 'high', max_tokens: 12000,\n  context: { client: c.client_name, website: c.website, services_bought: c.services, goals: c.goals, audience: c.audience, brand_voice: c.brand_voice, competitors: c.competitors },\n  task: `Create the product marketing context document for ${c.client_name}, following your playbook's structure, in Markdown. This document will be reused as context by every future AI task for this client, so be specific and mark assumptions to validate at kickoff with \"[validate]\".`,\n} } };\n"
      },
      "id": "d9051998-1e5d-4c62-ad5d-91cb2b5218f4",
      "name": "Prep Positioning Doc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        400
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.brain_workflow_id }}"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "cec54879-6075-4e48-9543-35d72a9790b9",
      "name": "Brain: Positioning Doc",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1440,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json;\nconst schema = { type: 'object', additionalProperties: false,\n  required: ['north_star_metric', 'goals', 'phases', 'quick_wins_first_2_weeks', 'access_needed', 'risks', 'kickoff_agenda'],\n  properties: { north_star_metric: { type: 'string' },\n    goals: { type: 'array', items: { type: 'object', additionalProperties: false, required: ['goal', 'metric', 'target'], properties: { goal: { type: 'string' }, metric: { type: 'string' }, target: { type: 'string' } } } },\n    phases: { type: 'array', items: { type: 'object', additionalProperties: false, required: ['name', 'weeks', 'focus', 'initiatives'],\n      properties: { name: { type: 'string' }, weeks: { type: 'string' }, focus: { type: 'string' }, initiatives: { type: 'array', items: { type: 'string' } } } } },\n    quick_wins_first_2_weeks: { type: 'array', items: { type: 'string' } }, access_needed: { type: 'array', items: { type: 'string' } },\n    risks: { type: 'array', items: { type: 'string' } }, kickoff_agenda: { type: 'array', items: { type: 'string' } } } };\nconst { ai, ai_text, ai_error, ai_meta, ...rest } = x;\nreturn { json: { ...rest, context_md: typeof ai === 'string' ? ai : `Context doc generation failed: ${ai_error}`, brain: {\n  skill: 'marketing-plan', caller: 'Onboarding', client: x.client_name, effort: 'high', max_tokens: 12000, schema,\n  context: { client: x.client_name, services_bought: x.services, monthly_retainer_usd: x.retainer_usd, goals: x.goals, positioning_doc: typeof ai === 'string' ? ai : '' },\n  task: 'Build a 90-day marketing plan scoped strictly to the services this client bought and a realistic workload for the retainer. Use three phases (weeks 1-4, 5-8, 9-12). Include what platform access we need on day one and a 45-minute kickoff agenda.',\n} } };\n"
      },
