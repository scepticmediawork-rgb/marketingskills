    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json; const a = x.ai || {};\nconst plan = (a.save_plan || []).map((s) => `\u2022 ${s.action} (_${s.owner_role}_, within ${s.due_in_days}d)`).join('\\n');\nreturn { json: { text: `${x.status === 'at-risk' ? ':red_circle:' : ':large_orange_circle:'} *${x.client_name}* health ${x.score}/100 (${x.status}) \u00b7 $${x.retainer_usd}/mo at stake\\n*Drivers:* ${x.drivers}\\n*Why it may be cooling:*\\n${(a.root_cause_hypotheses || []).map((h) => '\u2022 ' + h).join('\\n')}\\n*Save plan:*\\n${plan}\\n*Call talking points:*\\n${(a.call_talking_points || []).map((h) => '\u2022 ' + h).join('\\n')}\\n*Remind them of:*\\n${(a.value_reminders || []).map((h) => '\u2022 ' + h).join('\\n')}\\nAM: ${x.account_manager_email}` } };\n"
      },
