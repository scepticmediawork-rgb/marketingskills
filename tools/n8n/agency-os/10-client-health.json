    {
      "parameters": {
        "jsCode": "const free = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'icloud.com', 'aol.com', 'proton.me', 'live.com'];\nconst clients = $('Read Clients (inbox)').all().map((i) => i.json).filter((c) => c.client_id && c.contact_email);\nconst today = new Date().toISOString().slice(0, 10);\nconst hits = new Set();\nfor (const { json: m } of $('New Inbound Email').all()) {\n  const from = String(m.From || m.from || '').toLowerCase();\n  const addr = (from.match(/<([^>]+)>/) || [])[1] || from.trim();\n  const dom = addr.split('@')[1] || '';\n  for (const c of clients) {\n    const ce = String(c.contact_email).toLowerCase(); const cd = ce.split('@')[1] || '';\n    if (addr === ce || (dom && dom === cd && !free.includes(dom))) hits.add(c.client_id);\n  }\n}\nreturn [...hits].map((client_id) => ({ json: { client_id, last_client_reply: today } }));\n"
      },
