    {
      "parameters": {
        "jsCode": "const rowsOf = (node) => { try { return $(node).all().map((i) => i.json).filter((r) => r && Object.keys(r).length); } catch (e) { return []; } };\nconst activeClients = () => rowsOf('Read Clients').filter((c) => c.client_id && String(c.status || '').toLowerCase() === 'active');\nconst ymd = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\nconst daysAgo = (s) => { const t = Date.parse(s); return Number.isNaN(t) ? null : Math.floor((Date.now() - t) / 864e5); };\n\nconst metrics = rowsOf('Read Metrics'); const content = rowsOf('Read Content');\nconst week_of = ymd(new Date());\nreturn activeClients().map((c) => {\n  const hist = metrics.filter((m) => m.client_id === c.client_id).sort((a, b) => String(b.month).localeCompare(String(a.month)));\n  const latest = hist[0]; const drivers = [];\n  const isNew = (daysAgo(c.start_date) ?? 999) < 45;\n  let results = 20;\n  if (latest && latest.key_events_mom_pct !== '' && latest.key_events_mom_pct !== undefined) {\n    const mom = Number(latest.key_events_mom_pct);\n    results = mom >= 10 ? 40 : mom >= -5 ? 30 : mom >= -20 ? 15 : 0;\n    if (results < 30) drivers.push(`key events ${mom}% MoM`);\n  } else if (isNew) { results = 30; } else { drivers.push('no performance data'); }\n  const quiet = daysAgo(c.last_client_reply);\n  const resp = quiet === null ? 10 : quiet <= 7 ? 20 : quiet <= 14 ? 12 : quiet <= 30 ? 5 : 0;\n  if (resp < 12) drivers.push(quiet === null ? 'no reply date on file' : `client quiet for ${quiet} days`);\n  const overdue = Number(c.invoices_overdue) || 0;\n  const billing = overdue === 0 ? 20 : overdue === 1 ? 8 : 0;\n  if (overdue) drivers.push(`${overdue} invoice(s) overdue`);\n  const stuck = content.filter((r) => r.client_id === c.client_id && r.status === 'Pending approval' && Date.parse(r.publish_at) < Date.now() + 2 * 864e5).length;\n  const delivery = stuck === 0 ? 20 : stuck <= 2 ? 10 : 0;\n  if (stuck) drivers.push(`${stuck} post(s) stuck in approval`);\n  const score = results + resp + billing + delivery;\n  const status = score >= 75 ? 'healthy' : score >= 50 ? 'watch' : 'at-risk';\n  const schema = { type: 'object', additionalProperties: false, required: ['risk_level', 'root_cause_hypotheses', 'save_plan', 'call_talking_points', 'value_reminders'],\n    properties: { risk_level: { type: 'string', enum: ['watch', 'at-risk', 'critical'] }, root_cause_hypotheses: { type: 'array', items: { type: 'string' } },\n      save_plan: { type: 'array', items: { type: 'object', additionalProperties: false, required: ['action', 'owner_role', 'due_in_days'], properties: { action: { type: 'string' }, owner_role: { type: 'string' }, due_in_days: { type: 'integer' } } } },\n      call_talking_points: { type: 'array', items: { type: 'string' } }, value_reminders: { type: 'array', items: { type: 'string', description: 'Concrete wins delivered, taken from the data' } } } };\n  return { json: { week_of, client_id: c.client_id, client_name: c.client_name, retainer_usd: c.retainer_usd, account_manager_email: c.account_manager_email,\n    score, status, results_pts: results, responsiveness_pts: resp, billing_pts: billing, delivery_pts: delivery, drivers: drivers.join('; ') || 'none',\n    brain: { skill: 'churn-prevention', caller: 'Client Health', client: c.client_name, effort: 'high', max_tokens: 6000, schema,\n      context: { client: c.client_name, retainer_usd: c.retainer_usd, services: c.services, goals: c.goals, client_since: c.start_date, health_score: score, status, risk_drivers: drivers, recent_months: hist.slice(0, 3) },\n      task: 'This is a marketing-agency retainer client (a B2B service relationship, not a SaaS subscriber). Adapt the playbook to agency retention. Hypothesize why the relationship is cooling, then write a save plan the account team can run this week: specific actions with an owner role and a due date, talking points for a candid check-in call, and value reminders drawn only from the data.' } } };\n});\n"
      },
      "id": "3e3b5c36-9fae-4521-b652-b5b72ac230bf",
